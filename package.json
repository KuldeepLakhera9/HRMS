{
  "name": "hrms-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @hrms/web dev",
    "dev:worker": "pnpm --filter @hrms/worker dev",
    "db:migrate": "pnpm --filter @hrms/db migrate",
    "db:seed": "pnpm --filter @hrms/db seed",
    "seed:load": "pnpm --filter @hrms/db seed:load",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --project=integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
