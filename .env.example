# ==============================================================================
# HRMS Platform - Environment Configuration Template
# Notice: Copy this file to .env before starting the development environment.
# DO NOT COMMIT SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Node Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Connections (PostgreSQL + PostGIS)
# Default dev setup: hrms_db running locally or in Docker on port 5432
DATABASE_URL=postgresql://hrms_app:hrms_app_password@localhost:5432/hrms_db
# Dedicated connection for web app and API routes (non-owner role without BYPASSRLS)
DATABASE_APP_URL=postgresql://hrms_app:hrms_app_password@localhost:5432/hrms_db
# Dedicated connection for running migrations, schema modifications, and DDL
DATABASE_OWNER_URL=postgresql://hrms_owner:hrms_owner_password@localhost:5432/hrms_db
DATABASE_POOL_MAX=10

# Redis Cache and Queues
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3 compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_dev_password
MINIO_BUCKET_DOCUMENTS=hrms-documents
MINIO_BUCKET_EXPORTS=hrms-exports

# Email Delivery (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hrms.internal

# Observability
LOG_LEVEL=info
