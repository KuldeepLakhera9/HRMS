{
  "openapi": "3.1.0",
  "info": {
    "title": "HRMS Platform API (Phase 1)",
    "description": "Production-grade, self-hosted, multi-tenant HRMS API. All tenant endpoints strictly enforce Row-Level Security (RLS) and fine-grained RBAC permissions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-token"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hrms_session"
      }
    }
  },
  "security": [
    { "bearerAuth": [] },
    { "cookieAuth": [] }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness Probe",
        "description": "Returns 200 OK as long as the application process is running.",
        "security": [],
        "responses": {
          "200": { "description": "Process is alive." }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness Probe",
        "description": "Checks connectivity to PostgreSQL (hrms_app) and Redis.",
        "security": [],
        "responses": {
          "200": { "description": "Database and Redis are ready." },
          "503": { "description": "Database or Redis is not connected." }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Prometheus Metrics",
        "description": "Exposes standard Prometheus 0.0.4 metrics (pool stats, latencies, counters). Protected by internal network / token.",
        "responses": {
          "200": { "description": "Prometheus exposition text format." }
        }
      }
    },
    "/api/v1/dashboard/metrics": {
      "get": {
        "summary": "Dashboard Aggregated Metrics",
        "description": "Returns role-based real-time telemetry (headcount, joiners, pending change requests, expiring documents, recent audit count).",
        "responses": {
          "200": { "description": "Aggregated metrics." }
        }
      }
    },
    "/api/v1/custom-fields": {
      "get": {
        "summary": "List Custom Fields",
        "description": "Retrieves active custom field definitions for employee, department, or location with Redis caching.",
        "parameters": [
          { "name": "entity", "in": "query", "schema": { "type": "string", "enum": ["employee", "department", "location"] } }
        ],
        "responses": {
          "200": { "description": "List of custom field definitions." }
        }
      },
      "post": {
        "summary": "Create Custom Field",
        "description": "Creates a new custom field definition and invalidates Redis cache.",
        "responses": {
          "200": { "description": "Created field definition." }
        }
      }
    },
    "/api/v1/custom-fields/{id}": {
      "patch": {
        "summary": "Update Custom Field",
        "description": "Updates an existing custom field definition.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Updated definition." } }
      },
      "delete": {
        "summary": "Delete Custom Field",
        "description": "Soft-deletes a custom field definition.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Deleted." } }
      }
    },
    "/api/v1/employees/import": {
      "post": {
        "summary": "Validate Bulk CSV Import",
        "description": "Parses RFC-4180 CSV, validates against standard fields and dynamic custom fields, returns preview and error rows.",
        "responses": {
          "200": { "description": "Validation preview and job ID." }
        }
      }
    },
    "/api/v1/employees/import/{id}": {
      "get": {
        "summary": "Get Import Job Status",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Import job status and summary." } }
      }
    },
    "/api/v1/employees/import/{id}/confirm": {
      "post": {
        "summary": "Confirm Bulk Import",
        "description": "Executes batched idempotent upsert of valid rows in chunks of 500 inside tenant transaction.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Execution result." } }
      }
    },
    "/api/v1/employees/import/{id}/errors": {
      "get": {
        "summary": "Download Import Error CSV",
        "description": "Streams downloadable CSV containing all failed rows with row number, column, and reason.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Error CSV file." } }
      }
    },
    "/api/v1/employees/export": {
      "get": {
        "summary": "Export Employees CSV",
        "description": "Exports employee records to RFC-4180 CSV. Masks sensitive fields unless caller has employee:read_sensitive and active step-up session.",
        "parameters": [
          { "name": "includeSensitive", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "CSV stream." } }
      }
    },
    "/api/v1/employees/directory": {
      "get": {
        "summary": "Employee Directory Search",
        "description": "Keyset-paginated search utilizing pg_trgm trigram indices with departmental, status, and location filters.",
        "responses": { "200": { "description": "Employee directory rows." } }
      }
    },
    "/api/v1/employees/{id}": {
      "get": {
        "summary": "Get Employee Profile",
        "description": "Fetches employee details with sensitive fields masked by default.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Masked employee profile." } }
      }
    },
    "/api/v1/employees/{id}/sensitive": {
      "post": {
        "summary": "Reveal Sensitive Fields",
        "description": "Decrypts and reveals PAN, Aadhaar, and Bank Account after verifying step-up MFA challenge. Fully audited.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Decrypted sensitive fields." } }
      }
    },
    "/api/v1/audit-logs": {
      "get": {
        "summary": "Query Audit Trail",
        "description": "Keyset-paginated query of append-only monthly partitioned audit logs.",
        "responses": { "200": { "description": "Audit log entries." } }
      }
    },
    "/api/v1/leave/preview": {
      "post": {
        "summary": "Preview Leave Request Impact",
        "description": "Runs pure computeLeaveDays engine: calculates total days, sandwich deductions, net balance after request, clash warnings, and approval route.",
        "responses": { "200": { "description": "Leave preview calculation result." } }
      }
    },
    "/api/v1/leave/requests": {
      "get": {
        "summary": "List My Leave Requests",
        "description": "Returns leave requests with timeline history and workflow approval status.",
        "responses": { "200": { "description": "Leave request items." } }
      },
      "post": {
        "summary": "Submit Leave Request",
        "description": "Locks balance row FOR UPDATE, recomputes days server-side, validates EXCLUDE overlap constraint, and initiates workflow.",
        "responses": { "201": { "description": "Created leave request." } }
      }
    },
    "/api/v1/leave/calendar": {
      "get": {
        "summary": "Query Leave & Holiday Calendar",
        "description": "Returns day status chips with query budget <= 3, Redis 60s cache, and team/department/company scoping.",
        "parameters": [
          { "name": "startDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["team", "department", "company"] } }
        ],
        "responses": { "200": { "description": "Calendar matrix of leaves and holidays." } }
      }
    },
    "/api/v1/leave/balances": {
      "get": {
        "summary": "Get Leave Balances",
        "description": "Retrieves transactional leave balance snapshots (opening, accrued, used, adjusted, closing, available) per leave type.",
        "responses": { "200": { "description": "Leave balance cards data." } }
      }
    },
    "/api/v1/leave/types": {
      "get": {
        "summary": "List Leave Types",
        "description": "Lists configured company leave types with units, half-day, and sandwich rule configurations.",
        "responses": { "200": { "description": "List of leave types." } }
      }
    },
    "/api/v1/leave/admin/adjust": {
      "post": {
        "summary": "Manual Leave Balance Adjustment",
        "description": "Audited HR action writing an append-only 'adjustment' entry to leave_ledger and updating leave_balances atomically.",
        "responses": { "200": { "description": "Adjustment result." } }
      }
    },
    "/api/v1/reports": {
      "get": {
        "summary": "List Reports Catalog",
        "description": "Lists all 8 enterprise standard reports available to the caller's role based on permission scoping.",
        "responses": { "200": { "description": "Report definitions." } }
      }
    },
    "/api/v1/reports/{key}/preview": {
      "get": {
        "summary": "Synchronous Report Preview",
        "description": "Returns synchronous paged preview (top 50 records) in <= 200 ms.",
        "parameters": [{ "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Report columns and preview rows." } }
      }
    },
    "/api/v1/reports/[key]/export": {
      "post": {
        "summary": "Async Streaming Report Export",
        "description": "Streams up to 100,000 rows as CSV or XLSX directly to private MinIO storage with signed URL generation.",
        "parameters": [{ "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Export job queued or completed with signed download URL." } }
      }
    },
    "/api/v1/reports/runs": {
      "get": {
        "summary": "List Historical Report Runs",
        "description": "Returns status, duration, row count, and download links for historical export runs.",
        "responses": { "200": { "description": "Report run history." } }
      }
    },
    "/api/v1/announcements": {
      "get": {
        "summary": "List Company Announcements",
        "description": "Fetches active, non-expired announcements targeted to the caller's company, department, or role.",
        "responses": { "200": { "description": "List of announcements." } }
      },
      "post": {
        "summary": "Create Announcement",
        "description": "Publishes sanitized markdown announcement with audience targeting, pinned flag, and expiry.",
        "responses": { "201": { "description": "Created announcement." } }
      }
    },
    "/api/v1/announcements/{id}/read": {
      "post": {
        "summary": "Record Announcement Read Receipt",
        "description": "Records timestamped read receipt for current user.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Read receipt acknowledged." } }
      }
    },
    "/api/v1/helpdesk": {
      "get": {
        "summary": "List Helpdesk Tickets",
        "description": "Retrieves helpdesk tickets filtered by status, category, or assignee.",
        "responses": { "200": { "description": "List of tickets." } }
      },
      "post": {
        "summary": "Create Helpdesk Ticket",
        "description": "Submits a new helpdesk ticket with category, priority, and automated SLA calculation.",
        "responses": { "201": { "description": "Created ticket." } }
      }
    },
    "/api/v1/helpdesk/categories": {
      "get": {
        "summary": "List Helpdesk Categories",
        "description": "Returns helpdesk categories with assigned SLA hours.",
        "responses": { "200": { "description": "List of categories." } }
      }
    },
    "/api/v1/helpdesk/{id}": {
      "get": {
        "summary": "Get Ticket Details",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Ticket details." } }
      },
      "patch": {
        "summary": "Update Ticket Status / Priority",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Updated ticket." } }
      }
    },
    "/api/v1/helpdesk/{id}/comments": {
      "get": {
        "summary": "List Ticket Comments",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Threaded comments." } }
      },
      "post": {
        "summary": "Add Ticket Comment",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "201": { "description": "Added comment." } }
      }
    },
    "/api/v1/migration/leave-balances/preview": {
      "post": {
        "summary": "Preview Opening Leave Balance Import",
        "description": "Parses and validates CSV against employee codes and leave types, returning preview analysis and row errors.",
        "responses": { "200": { "description": "Validation preview summary." } }
      }
    },
    "/api/v1/migration/leave-balances/confirm": {
      "post": {
        "summary": "Confirm Opening Leave Balance Import",
        "description": "Executes idempotent import creating 'opening' ledger records with dedupe keys and updates balances.",
        "responses": { "200": { "description": "Batch creation result." } }
      }
    },
    "/api/v1/migration/batches": {
      "get": {
        "summary": "List Migration Batches",
        "description": "Lists all historical migration batches with row counts, status, and error counts.",
        "responses": { "200": { "description": "Batch records." } }
      }
    },
    "/api/v1/migration/batches/{id}/revert": {
      "post": {
        "summary": "Revert Migration Batch",
        "description": "Rolls back an imported migration batch with 1 click by executing reversing ledger adjustments or removing synthetic punches.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Batch reverted." } }
      }
    },
    "/api/v1/pilot/metrics": {
      "get": {
        "summary": "Pilot Adoption & Operational Telemetry",
        "description": "Aggregates real-time pilot metrics: user adoption rate, punch channel split, regularization rate, approval turnaround, and CSAT scores.",
        "responses": { "200": { "description": "Telemetry metrics data." } }
      }
    },
    "/api/v1/pilot/feedback": {
      "get": {
        "summary": "List User Feedback Submissions",
        "responses": { "200": { "description": "List of feedback submissions." } }
      },
      "post": {
        "summary": "Submit CSAT Feedback",
        "description": "Submits 1-5 star user feedback with category and page context.",
        "responses": { "201": { "description": "Recorded feedback." } }
      }
    }
  }
}
