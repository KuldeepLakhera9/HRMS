NODE_ENV=production
PORT={{ app_port }}
HOSTNAME=0.0.0.0

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_pooler_host }}:{{ db_pooler_port }}/{{ db_name }}?sslmode=prefer

# Redis / Valkey Sentinel
REDIS_HOST={{ valkey_sentinel_host }}
REDIS_PORT={{ valkey_sentinel_port }}
REDIS_SENTINEL_MASTER={{ valkey_master_name }}
REDIS_PASSWORD={{ valkey_password }}

# Object Storage S3
S3_ENDPOINT={{ s3_endpoint }}
S3_ACCESS_KEY={{ s3_access_key }}
S3_SECRET_KEY={{ s3_secret_key }}
S3_BUCKET_DOCUMENTS=hrms-documents
S3_BUCKET_EXPORTS=hrms-exports
S3_BUCKET_AUDIT=hrms-audit
S3_REGION={{ s3_region }}

# Outbound HTTP Proxy
HTTP_PROXY={{ egress_proxy_url }}
HTTPS_PROXY={{ egress_proxy_url }}
NO_PROXY=localhost,127.0.0.1,10.10.0.0/16
