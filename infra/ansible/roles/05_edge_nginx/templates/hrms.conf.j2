upstream hrms_app_backend {
{% for host in nginx_app_upstreams %}
    server {{ host }} max_fails=3 fail_timeout=10s;
{% endfor %}
    keepalive 32;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }};

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Primary Virtual Host
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }};

    # Certificates
    ssl_certificate /etc/ssl/hrms/certs/edge.crt;
    ssl_certificate_key /etc/ssl/hrms/private/edge.key;

    # HSTS & Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    # Maintenance Mode Check
    error_page 503 @maintenance;
    location @maintenance {
        root /var/www/hrms/public;
        rewrite ^(.*)$ /maintenance.html break;
    }

    if (-f /etc/nginx/maintenance.flag) {
        return 503;
    }

    # Static Maintenance Page Asset
    location = /maintenance.html {
        root /var/www/hrms/public;
        internal;
    }

    # Next.js Immutable Static Cache
    location /_next/static/ {
        proxy_pass http://hrms_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Public static files
    location /static/ {
        proxy_pass http://hrms_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Server-Sent Events (SSE) stream endpoint
    location ~* ^/api/v1/events/stream.* {
        proxy_pass http://hrms_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;

        # Mandatory SSE settings
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding off;
    }

    # Auth Rate Limiting
    location ~* ^/api/v1/auth/(login|verify-otp|reset-password) {
        limit_req zone=auth_rate_limit burst=5 nodelay;

        proxy_pass http://hrms_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;
    }

    # Default Application Proxy
    location / {
        limit_req zone=api_rate_limit burst=50 nodelay;
        limit_conn conn_limit 50;

        proxy_pass http://hrms_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
