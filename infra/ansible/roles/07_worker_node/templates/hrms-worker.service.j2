[Unit]
Description=HRMS BullMQ Background Worker Service
After=network.target

[Service]
Type=simple
User={{ worker_user }}
Group={{ worker_group }}
WorkingDirectory={{ worker_root_dir }}
EnvironmentFile=/etc/hrms/hrms-worker.env
ExecStart=/usr/bin/node packages/worker/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
SendSIGKILL=yes

# Sandboxing & Resource constraints
LimitNOFILE=65535
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
