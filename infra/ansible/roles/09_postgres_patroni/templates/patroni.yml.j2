scope: {{ patroni_scope }}
namespace: {{ patroni_namespace }}
name: {{ inventory_hostname }}

restapi:
  listen: {{ ansible_default_ipv4.address }}:{{ patroni_rest_port }}
  connect_address: {{ ansible_default_ipv4.address }}:{{ patroni_rest_port }}

etcd3:
  hosts:
{% for host in etcd_hosts %}
    - {{ host }}
{% endfor %}
  cacert: /etc/ssl/hrms/hrms-internal-ca.crt
  cert: /etc/ssl/hrms/certs/patroni.crt
  key: /etc/ssl/hrms/private/patroni.key

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    synchronous_mode_strict: false # Per ADR 0019
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        shared_buffers: {{ pg_shared_buffers }}
        effective_cache_size: {{ pg_effective_cache_size }}
        work_mem: {{ pg_work_mem }}
        maintenance_work_mem: {{ pg_maintenance_work_mem }}
        max_connections: {{ pg_max_connections }}
        min_wal_size: 2GB
        max_wal_size: 16GB
        checkpoint_completion_target: 0.9
        wal_buffers: 16MB
        default_statistics_target: 100
        random_page_cost: 1.1
        effective_io_concurrency: 200
        wal_level: replica
        archive_mode: "on"
        archive_command: "pgbackrest --stanza=hrms archive-push %p"
        hot_standby: "on"
        track_io_timing: "on"
        track_functions: "all"
        shared_preload_libraries: "pg_stat_statements,auto_explain"
        auto_explain.log_min_duration: "500ms"
        auto_explain.log_analyze: "on"
        statement_timeout: 30000
        idle_in_transaction_session_timeout: 60000
        lock_timeout: 3000
        password_encryption: scram-sha-256
        ssl: "on"
        ssl_cert_file: "/etc/ssl/hrms/certs/postgres.crt"
        ssl_key_file: "/etc/ssl/hrms/private/postgres.key"
        ssl_ca_file: "/etc/ssl/hrms/hrms-internal-ca.crt"

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - hostssl replication {{ db_repl_user }} 10.10.30.0/24 scram-sha-256
    - hostssl {{ patroni_scope }} {{ db_app_user }} 10.10.20.0/24 scram-sha-256
    - hostssl {{ patroni_scope }} {{ db_app_user }} 10.10.30.0/24 scram-sha-256
    - hostssl all {{ db_superuser }} 10.10.50.0/24 scram-sha-256
    - local all postgres peer
    - local all all scram-sha-256

postgresql:
  listen: {{ ansible_default_ipv4.address }}:5432,127.0.0.1:5432
  connect_address: {{ ansible_default_ipv4.address }}:5432
  data_dir: {{ patroni_data_dir }}
  bin_dir: /usr/lib/postgresql/16/bin
  pgpass: /var/lib/postgresql/.pgpass
  authentication:
    replication:
      username: {{ db_repl_user }}
      password: {{ db_repl_password }}
    superuser:
      username: {{ db_superuser }}
      password: {{ db_superuser_password }}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
